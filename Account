return (
  <div className="transaction-codes-container dls-p-4 dls-bg-white dls-border dls-border-radius-md">
    {/* Header */}
    <div className="header-section dls-flex dls-flex-justify-between dls-flex-align-end dls-mb-4 dls-pb-2">
      {/* Title + subtitle */}
      <div className="title-section">
        <h2 className="dls-text-heading-md dls-mb-1">Transaction Codes</h2>
        <p className="subtitle dls-text-body-sm dls-text-color-secondary dls-italic dls-m-0">
          Enterprise Catalog Business Term Definition: DEFINITION
        </p>
      </div>

      {/* Controls (source filter, download, columns) */}
      <div className="header-controls dls-flex dls-flex-align-center dls-flex-gap-2">
        {/* Source Filter */}
        <select
          className="source-filter dls-form-control dls-font-size-sm dls-border dls-border-radius-sm dls-bg-white"
          value={sourceFilterMode}
          onChange={(e) => setSourceFilterMode(e.target.value)}
        >
          <option value="all">All Sources</option>
          <option value="globestar">Globestar Only</option>
          <option value="triumph">Triumph Only</option>
          <option value="cars">CARS Only</option>
        </select>

        {/* Download */}
        <div className="download-container dls-position-relative" ref={downloadMenuRef}>
          <button
            className="download-btn dls-btn dls-btn-secondary dls-font-size-sm dls-flex dls-flex-align-center dls-flex-gap-1"
            onClick={() => setShowDownloadMenu(!showDownloadMenu)}
          >
            <span className="download-icon">⬇</span>
            Download
          </button>

          {showDownloadMenu && (
            <div className="download-dropdown dls-position-absolute dls-right-0 dls-top-full dls-mt-1 dls-bg-white dls-border dls-border-radius-sm dls-shadow-md dls-min-w-40 dls-z-10">
              <div className="dropdown-header dls-font-weight-semibold dls-font-size-sm dls-p-2 dls-border-b">
                Export Format
              </div>

              <button
                className="download-option dls-w-100 dls-text-left dls-btn-reset dls-p-2 dls-font-size-sm dls-flex dls-flex-align-center dls-flex-gap-1 dls-hover-bg-subtle"
                onClick={downloadAsExcel}
              >
                <span className="file-icon">📗</span> Download as Excel
              </button>

              <button
                className="download-option dls-w-100 dls-text-left dls-btn-reset dls-p-2 dls-font-size-sm dls-flex dls-flex-align-center dls-flex-gap-1 dls-hover-bg-subtle"
                onClick={downloadAsCSV}
              >
                <span className="file-icon">📊</span> Download as CSV
              </button>

              <button
                className="download-option dls-w-100 dls-text-left dls-btn-reset dls-p-2 dls-font-size-sm dls-flex dls-flex-align-center dls-flex-gap-1 dls-hover-bg-subtle"
                onClick={downloadAsJSON}
              >
                <span className="file-icon">📄</span> Download as JSON
              </button>
            </div>
          )}
        </div>

        {/* Column Toggle */}
        <div className="column-toggle-container dls-position-relative" ref={columnToggleRef}>
          <button
            className="column-toggle-btn dls-btn dls-btn-secondary dls-font-size-sm dls-flex dls-flex-align-center dls-flex-gap-1"
            onClick={() => setShowColumnToggle(!showColumnToggle)}
          >
            <span className="toggle-icon">⚙️</span>
            Columns
          </button>

          {showColumnToggle && (
            <div className="column-toggle-dropdown dls-position-absolute dls-right-0 dls-top-full dls-mt-1 dls-bg-white dls-border dls-border-radius-sm dls-shadow-md dls-min-w-56 dls-z-10">
              <div className="dropdown-header dls-font-weight-semibold dls-font-size-sm dls-p-2 dls-border-b">
                Show/Hide Columns
              </div>

              {Object.entries(activeColumnLabels).map(([key, label]) => {
                if (key === 'marketLocation') {
                  return (
                    <label
                      key={key}
                      className="column-checkbox dls-flex dls-flex-align-center dls-px-3 dls-py-2 dls-cursor-not-allowed dls-text-color-secondary"
                      title="This column is universal and cannot be hidden"
                    >
                      <input type="checkbox" checked readOnly disabled className="dls-mr-2" />
                      <span className="checkbox-label dls-font-size-sm">{label}</span>
                    </label>
                  );
                }
                return (
                  <label
                    key={key}
                    className="column-checkbox dls-flex dls-flex-align-center dls-px-3 dls-py-2 dls-hover-bg-subtle"
                  >
                    <input
                      type="checkbox"
                      className="dls-mr-2"
                      checked={!!visibleColumns[key]}
                      onChange={() => toggleColumn(key)}
                    />
                    <span className="checkbox-label dls-font-size-sm">{label}</span>
                  </label>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>

    {/* Table */}
    <table className="table dls-w-100 dls-border-collapse dls-table dls-table-striped">
      <thead>
        <tr>
          {activeKeys.map((key) => {
            const label = activeColumnLabels[key];
            if (key === 'marketLocation') return (
              <th scope="col" key={key} className="dls-bg-brand dls-text-inverse dls-font-weight-semibold dls-font-size-sm dls-text-uppercase dls-letter-spacing-sm dls-px-3 dls-py-2">
                {label}
              </th>
            );
            if (!visibleColumns[key]) return null;
            return (
              <th scope="col" key={key} className="dls-bg-brand dls-text-inverse dls-font-weight-semibold dls-font-size-sm dls-text-uppercase dls-letter-spacing-sm dls-px-3 dls-py-2">
                {label}
              </th>
            );
          })}
        </tr>
      </thead>

      <tbody>
        {/* Filter row */}
        <tr className="filter-row">
          {activeKeys.map((key) => {
            const cellClass =
              "dls-bg-subtle dls-p-1 dls-position-relative dls-border";
            if (key === 'marketLocation') {
              return (
                <td key={`filter-${key}`} className={cellClass}>
                  {renderFilterInput('marketLocation', 'Filter Market Location', {
                    inputClass: 'dls-form-control dls-font-size-sm',
                    wrapClass: 'dls-position-relative dls-w-100'
                  })}
                </td>
              );
            }
            return (
              <td key={`filter-${key}`} className={cellClass}>
                {renderFilterInput(key, `Filter ${activeColumnLabels[key]}`, {
                  inputClass: 'dls-form-control dls-font-size-sm',
                  wrapClass: 'dls-position-relative dls-w-100',
                  listClass: 'dls-position-absolute dls-left-0 dls-right-0 dls-top-full dls-bg-white dls-border dls-max-h-56 dls-overflow-auto dls-z-20'
                })}
              </td>
            );
          })}
        </tr>

        {/* Data rows */}
        {currentData.map((row, idx) => (
          <tr key={`trans-code-${startIndex + idx}`}>
            {activeKeys.map((key) => {
              const val = (row[key] || '').toString();
              if (key === 'marketLocation')
                return <td key={`${idx}-${key}`} className="dls-px-3 dls-py-2 dls-border">{val || '-'}</td>;
              if (!visibleColumns[key]) return null;
              return <td key={`${idx}-${key}`} className="dls-px-3 dls-py-2 dls-border">{val}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>

    {/* Empty state */}
    {!filteredData.length && (
      <div className="no-transactions-found dls-mt-2 dls-text-color-secondary dls-italic">
        No Transaction Codes To Be Displayed
      </div>
    )}

    {/* Pagination */}
    {filteredData.length > 0 && (
      <div className="pagination-container dls-flex dls-flex-justify-between dls-flex-align-center dls-mt-3 dls-flex-wrap dls-flex-gap-2">
        <div className="showing-info dls-text-body-sm">
          Showing rows {startIndex + 1}-{Math.min(endIndex, filteredData.length)} of {filteredData.length}
        </div>

        {totalPages > 1 && (
          <div className="pagination-controls dls-flex dls-flex-align-center dls-flex-gap-1">
            <button
              className="page-btn dls-btn dls-btn-secondary dls-btn-sm"
              onClick={() => setCurrentPage(1)}
              disabled={currentPage === 1}
            >
              First
            </button>

            <button
              className="page-btn dls-btn dls-btn-secondary dls-btn-sm"
              onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}
              disabled={currentPage === 1}
            >
              Previous
            </button>

            {getPageNumbers().map((page, index) =>
              page === '...' ? (
                <span key={`ellipsis-${index}`} className="page-ellipsis dls-px-1 dls-text-color-secondary">…</span>
              ) : (
                <button
                  key={`page-${page}`}
                  className={`page-btn dls-btn dls-btn-sm ${
                    currentPage === page ? 'dls-btn-brand' : 'dls-btn-secondary'
                  }`}
                  onClick={() => setCurrentPage(page)}
                >
                  {page}
                </button>
              )
            )}

            <button
              className="page-btn dls-btn dls-btn-secondary dls-btn-sm"
              onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}
              disabled={currentPage === totalPages}
            >
              Next
            </button>

            <button
              className="page-btn dls-btn dls-btn-secondary dls-btn-sm"
              onClick={() => setCurrentPage(totalPages)}
              disabled={currentPage === totalPages}
            >
              Last
            </button>
          </div>
        )}
      </div>
    )}
  </div>
);