return (
  <div className="transaction-codes-container pad-2 border">
    {/* Header */}
    <div className="header-section flex flex-justify-between flex-align-end margin-2-b pad-1-b border-bottom">
      {/* Title + subtitle */}
      <div className="title-section">
        <h2 className="margin-0 font-weight-bold">Transaction Codes</h2>
        <p className="subtitle text-neutral font-italic margin-0">
          Enterprise Catalog Business Term Definition: DEFINITION
        </p>
      </div>

      {/* Controls */}
      <div className="header-controls flex flex-align-center stack-1-r">
        {/* Source Filter */}
        <select
          className="source-filter border pad-1-t-b pad-1-l-r"
          value={sourceFilterMode}
          onChange={(e) => setSourceFilterMode(e.target.value)}
        >
          <option value="all">All Sources</option>
          <option value="globestar">Globestar Only</option>
          <option value="triumph">Triumph Only</option>
          <option value="cars">CARS Only</option>
        </select>

        {/* Download Menu */}
        <div className="download-container position-relative" ref={downloadMenuRef}>
          <button
            className="download-btn border pad-1-t-b pad-1-l-r flex flex-align-center"
            onClick={() => setShowDownloadMenu(!showDownloadMenu)}
          >
            <span className="download-icon">⬇</span>
            <span className="margin-1-l">Download</span>
          </button>

          {showDownloadMenu && (
            <div
              className="download-dropdown position-absolute-tr margin-1-t border pad-1"
              style={{
                backgroundColor: '#fff',
                borderRadius: '4px',
                boxShadow: '0 4px 12px rgba(0,0,0,0.15)',
                zIndex: 10,
                minWidth: '190px'
              }}
            >
              <div
                className="dropdown-header font-weight-bold border-bottom pad-1"
                style={{ marginBottom: '4px' }}
              >
                Export Format
              </div>

              <button
                className="download-option display-block pad-1 text-align-left border-0 width-full"
                onClick={downloadAsExcel}
                style={{ background: 'none', cursor: 'pointer' }}
              >
                📗 <span className="margin-1-l">Download as Excel</span>
              </button>

              <button
                className="download-option display-block pad-1 text-align-left border-0 width-full"
                onClick={downloadAsCSV}
                style={{ background: 'none', cursor: 'pointer' }}
              >
                📊 <span className="margin-1-l">Download as CSV</span>
              </button>

              <button
                className="download-option display-block pad-1 text-align-left border-0 width-full"
                onClick={downloadAsJSON}
                style={{ background: 'none', cursor: 'pointer' }}
              >
                📄 <span className="margin-1-l">Download as JSON</span>
              </button>
            </div>
          )}
        </div>

        {/* Column Toggle */}
        <div className="column-toggle-container position-relative" ref={columnToggleRef}>
          <button
            className="column-toggle-btn border pad-1-t-b pad-1-l-r flex flex-align-center"
            onClick={() => setShowColumnToggle(!showColumnToggle)}
          >
            <span className="toggle-icon">⚙️</span>
            <span className="margin-1-l">Columns</span>
          </button>

          {showColumnToggle && (
            <div
              className="column-toggle-dropdown position-absolute-tr margin-1-t border pad-1"
              style={{
                backgroundColor: '#fff',
                borderRadius: '4px',
                boxShadow: '0 4px 12px rgba(0,0,0,0.15)',
                zIndex: 10,
                minWidth: '220px'
              }}
            >
              <div
                className="dropdown-header font-weight-bold border-bottom pad-1"
                style={{ marginBottom: '4px' }}
              >
                Show/Hide Columns
              </div>

              {Object.entries(activeColumnLabels).map(([key, label]) => {
                if (key === 'marketLocation') {
                  return (
                    <label
                      key={key}
                      className="display-block pad-1 text-neutral"
                      title="This column is universal and cannot be hidden"
                    >
                      <input type="checkbox" checked readOnly disabled className="margin-1-r" />
                      {label}
                    </label>
                  );
                }
                return (
                  <label key={key} className="display-block pad-1">
                    <input
                      type="checkbox"
                      className="margin-1-r"
                      checked={!!visibleColumns[key]}
                      onChange={() => toggleColumn(key)}
                    />
                    {label}
                  </label>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>

    {/* Table */}
    <table className="width-full border">
      <thead>
        <tr>
          {activeKeys.map((key) => {
            const label = activeColumnLabels[key];
            if (key === 'marketLocation') {
              return (
                <th
                  scope="col"
                  key={key}
                  className="font-weight-bold text-uppercase pad-1-l-r pad-1-t-b border-bottom"
                >
                  {label}
                </th>
              );
            }
            if (!visibleColumns[key]) return null;
            return (
              <th
                scope="col"
                key={key}
                className="font-weight-bold text-uppercase pad-1-l-r pad-1-t-b border-bottom"
              >
                {label}
              </th>
            );
          })}
        </tr>
      </thead>

      <tbody>
        {/* Filter row */}
        <tr className="filter-row">
          {activeKeys.map((key) => {
            const cellClass = "pad-1 position-relative border";
            if (key === 'marketLocation') {
              return (
                <td key={`filter-${key}`} className={cellClass}>
                  {renderFilterInput('marketLocation', 'Filter Market Location', {
                    inputClass: 'width-full',
                    wrapClass: 'position-relative width-full'
                  })}
                </td>
              );
            }
            return (
              <td key={`filter-${key}`} className={cellClass}>
                {renderFilterInput(key, `Filter ${activeColumnLabels[key]}`, {
                  inputClass: 'width-full',
                  wrapClass: 'position-relative width-full',
                  listClass: 'position-absolute width-full'
                })}
              </td>
            );
          })}
        </tr>

        {/* Data rows */}
        {currentData.map((row, idx) => (
          <tr key={`trans-code-${startIndex + idx}`}>
            {activeKeys.map((key) => {
              const val = (row[key] || '').toString();
              if (key === 'marketLocation') {
                return (
                  <td key={`${idx}-${key}`} className="pad-1-l-r pad-1-t-b border">
                    {val || '-'}
                  </td>
                );
              }
              if (!visibleColumns[key]) return null;
              return (
                <td key={`${idx}-${key}`} className="pad-1-l-r pad-1-t-b border">
                  {val}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>

    {/* Empty state */}
    {!filteredData.length && (
      <div className="margin-1-t text-neutral font-italic">
        No Transaction Codes To Be Displayed
      </div>
    )}

    {/* Pagination */}
    {filteredData.length > 0 && (
      <div className="pagination-container flex flex-justify-between flex-align-center margin-2-t stack-1-r">
        <div>
          Showing rows {startIndex + 1}-{Math.min(endIndex, filteredData.length)} of{' '}
          {filteredData.length}
        </div>

        {totalPages > 1 && (
          <div className="pagination-controls flex">
            <button
              className="page-btn border pad-1-l-r pad-1-t-b margin-0"
              onClick={() => setCurrentPage(1)}
              disabled={currentPage === 1}
            >
              First
            </button>

            <button
              className="page-btn border pad-1-l-r pad-1-t-b margin-0"
              onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}
              disabled={currentPage === 1}
            >
              Previous
            </button>

            {getPageNumbers().map((page, index) =>
              page === '...' ? (
                <span key={`ellipsis-${index}`} className="margin-1-l-r text-neutral">
                  …
                </span>
              ) : (
                <button
                  key={`page-${page}`}
                  className={`page-btn border pad-1-l-r pad-1-t-b margin-0 ${
                    currentPage === page ? 'font-weight-bold' : ''
                  }`}
                  onClick={() => setCurrentPage(page)}
                >
                  {page}
                </button>
              )
            )}

            <button
              className="page-btn border pad-1-l-r pad-1-t-b margin-0"
              onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}
              disabled={currentPage === totalPages}
            >
              Next
            </button>

            <button
              className="page-btn border pad-1-l-r pad-1-t-b margin-0"
              onClick={() => setCurrentPage(totalPages)}
              disabled={currentPage === totalPages}
            >
              Last
            </button>
          </div>
        )}
      </div>
    )}
  </div>
);