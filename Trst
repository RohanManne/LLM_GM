import React, { useState, useEffect } from 'react';
import {
  CheckboxGroup,
  Checkbox,
  Button
} from '@americanexpress/dls-react';

const ALL_FIELDS = ['name', 'value', 'description', 'source'];

const FilterMenu = ({ filters, setFilters, onClose }) => {
  const [tempFilters, setTempFilters] = useState(filters);

  useEffect(() => {
    setTempFilters(filters);
  }, [filters]);

  const toggleTempFilter = (field) => {
    setTempFilters((prev) =>
      prev.includes(field)
        ? prev.filter((f) => f !== field)
        : [...prev, field]
    );
  };

  const handleApply = () => {
    setFilters(tempFilters);
    onClose();
  };

  const handleReset = () => {
    setTempFilters([]);
  };

  return (
    <div>
      <CheckboxGroup legend="Filter Columns">
        {ALL_FIELDS.map((field) => (
          <Checkbox
            key={field}
            id={field}
            label={field}
            checked={tempFilters.includes(field)}
            onChange={() => toggleTempFilter(field)}
          />
        ))}
      </CheckboxGroup>

      <div style={{ display: 'flex', justifyContent: 'flex-end', gap: '12px', marginTop: '16px' }}>
        <Button variant="text" onClick={handleReset}>Reset</Button>
        <Button variant="primary" onClick={handleApply}>Apply</Button>
      </div>
    </div>
  );
};

export default FilterMenu;

import React, { useState, useRef } from 'react';
import {
  DataTable, DataTableHead, DataTableBody, DataTableRow,
  DataTableCell, DataTableHeadCell, Button
} from '@americanexpress/dls-react';
import { IconDownload, IconFilter } from '@americanexpress/dls-icons';

import triumphTransData from '../data/Triumph_Trans_Codes.json';
import triumphStatusData from '../data/Triumph_Status_Codes.json';
import FilterMenu from './FilterMenu';

const TabbedTables = () => {
  const [activeTab, setActiveTab] = useState(null);
  const [filters, setFilters] = useState(['name', 'value', 'description', 'source']);
  const [showFilterMenu, setShowFilterMenu] = useState(false);
  const [showDownloadMenu, setShowDownloadMenu] = useState(false);

  const transData = triumphTransData.Triumph_Trans_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const acctData = triumphStatusData.Triumph_Status_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const handleToggle = (tab) => {
    setActiveTab((prev) => (prev === tab ? null : tab));
    setShowDownloadMenu(false);
    setShowFilterMenu(false);
    setFilters(['name', 'value', 'description', 'source']); // Reset filters on tab change
  };

  const getFilteredRows = () => {
    const rows = activeTab === 'trans' ? transData : acctData;
    if (filters.length === 0) return rows;
    return rows.map((row) => {
      const filteredRow = {};
      filters.forEach((key) => {
        filteredRow[key] = row[key];
      });
      return filteredRow;
    });
  };

  const downloadData = (format) => {
    const data = getFilteredRows();
    let blob, filename;

    if (format === 'json') {
      blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      filename = activeTab === 'trans' ? 'Transaction_Codes.json' : 'Account_Status_Codes.json';
    } else {
      const header = filters.join(',');
      const csvRows = data.map(row => filters.map(f => `"${row[f] ?? ''}"`).join(','));
      const csvContent = [header, ...csvRows].join('\n');
      blob = new Blob([csvContent], { type: 'text/csv' });
      filename = activeTab === 'trans' ? 'Transaction_Codes.csv' : 'Account_Status_Codes.csv';
    }

    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    setShowDownloadMenu(false);
  };

  const renderTable = (rows) => (
    <div style={{ maxHeight: '50vh', overflow: 'auto', padding: '0 10%', boxSizing: 'border-box' }}>
      <DataTable borders="all" density="default" tableLayout="auto">
        <DataTableHead>
          <DataTableRow>
            {filters.includes('name') && <DataTableHeadCell>Field Name</DataTableHeadCell>}
            {filters.includes('value') && <DataTableHeadCell>Field Value</DataTableHeadCell>}
            {filters.includes('description') && <DataTableHeadCell>Field Description</DataTableHeadCell>}
            {filters.includes('source') && <DataTableHeadCell>System Source Name</DataTableHeadCell>}
          </DataTableRow>
        </DataTableHead>
        <DataTableBody>
          {rows.map((row, i) => (
            <DataTableRow key={i}>
              {filters.includes('name') && <DataTableCell>{row.name}</DataTableCell>}
              {filters.includes('value') && <DataTableCell>{row.value}</DataTableCell>}
              {filters.includes('description') && <DataTableCell>{row.description}</DataTableCell>}
              {filters.includes('source') && <DataTableCell>{row.source}</DataTableCell>}
            </DataTableRow>
          ))}
        </DataTableBody>
      </DataTable>
    </div>
  );

  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'center', gap: '30px', marginTop: '40px' }}>
        <Button variant={activeTab === 'trans' ? 'secondary' : 'primary'} onClick={() => handleToggle('trans')}>
          Transaction Codes
        </Button>
        <Button variant={activeTab === 'acct' ? 'secondary' : 'primary'} onClick={() => handleToggle('acct')}>
          Account Status Codes
        </Button>
      </div>

      {activeTab && (
        <div style={{ display: 'flex', gap: '12px', marginTop: '20px', justifyContent: 'center', position: 'relative' }}>
          <IconDownload
            filled={true}
            title="Download"
            onClick={() => {
              setShowDownloadMenu((prev) => !prev);
              setShowFilterMenu(false);
            }}
            style={{ border: '1px solid #ccc', borderRadius: '4px', padding: '6px', cursor: 'pointer' }}
          />

          <IconFilter
            filled={true}
            title="Filter"
            onClick={() => {
              setShowFilterMenu((prev) => !prev);
              setShowDownloadMenu(false);
            }}
            style={{ border: '1px solid #ccc', borderRadius: '4px', padding: '6px', cursor: 'pointer' }}
          />

          {showDownloadMenu && (
            <div style={{
              position: 'absolute',
              top: '36px',
              left: '0',
              background: 'white',
              border: '1px solid #ccc',
              borderRadius: '4px',
              zIndex: 10,
              padding: '8px',
              boxShadow: '0 2px 6px rgba(0,0,0,0.1)'
            }}>
              <div style={{ padding: '6px', cursor: 'pointer' }} onClick={() => downloadData('json')}>Download JSON</div>
              <div style={{ padding: '6px', cursor: 'pointer' }} onClick={() => downloadData('csv')}>Download CSV</div>
            </div>
          )}

          {showFilterMenu && (
            <div style={{
              position: 'absolute',
              top: '36px',
              left: '50px',
              background: 'white',
              border: '1px solid #ccc',
              borderRadius: '4px',
              zIndex: 10,
              padding: '12px',
              boxShadow: '0 2px 6px rgba(0,0,0,0.1)'
            }}>
              <FilterMenu filters={filters} setFilters={setFilters} onClose={() => setShowFilterMenu(false)} />
            </div>
          )}
        </div>
      )}

      {activeTab && renderTable(getFilteredRows())}
    </div>
  );
};

export default TabbedTables;