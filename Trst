import React from 'react';
import { Menu, MenuItem } from '@americanexpress/dls-react';
import { IconFilter } from '@americanexpress/dls-icons';

const ALL_FIELDS = ['name', 'value', 'description', 'source'];

const FilterMenu = ({ filters, setFilters }) => {
  const toggleFilter = (field) => {
    setFilters((prev) =>
      prev.includes(field)
        ? prev.filter((f) => f !== field)
        : [...prev, field]
    );
  };

  return (
    <Menu
      label="Filter"
      placement="bottom"
      size="small"
      hideCaret
      renderAnchor={({ toggleMenu }) => (
        <span onClick={toggleMenu}>
          <IconFilter
            filled
            title="Filter Columns"
            titleId="filter-icon"
            style={{
              border: '1px solid #ccc',
              borderRadius: '4px',
              padding: '6px',
              cursor: 'pointer',
            }}
          />
        </span>
      )}
    >
      {ALL_FIELDS.map((field) => (
        <MenuItem key={field}>
          <label style={{ display: 'flex', alignItems: 'center' }}>
            <input
              type="checkbox"
              checked={filters.includes(field)}
              onChange={() => toggleFilter(field)}
              style={{ marginRight: '8px' }}
            />
            {field}
          </label>
        </MenuItem>
      ))}
    </Menu>
  );
};

export default FilterMenu;

import React, { useState } from 'react';
import {
  DataTable,
  DataTableHead,
  DataTableBody,
  DataTableRow,
  DataTableCell,
  DataTableHeadCell,
  Button,
} from '@americanexpress/dls-react';
import { IconDownload } from '@americanexpress/dls-icons';
import triumphTransData from '../data/Triumph_Trans_Codes.json';
import triumphStatusData from '../data/Triumph_Status_Codes.json';
import FilterMenu from './FilterMenu';

const TabbedTables = () => {
  const [activeTab, setActiveTab] = useState(null);
  const [filters, setFilters] = useState([]);

  const transData = triumphTransData.Triumph_Trans_Codes.map(item => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const acctData = triumphStatusData.Triumph_Status_Codes.map(item => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const handleToggle = tab => {
    setActiveTab(prev => (prev === tab ? null : tab));
    setFilters([]); // reset filters on tab switch
  };

  const handleDownload = () => {
    const data = activeTab === 'trans' ? transData : acctData;
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = activeTab === 'trans' ? 'Transaction_Codes.json' : 'Account_Status_Codes.json';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const handleFilterChange = fieldName => {
    setFilters(prev =>
      prev.includes(fieldName)
        ? prev.filter(f => f !== fieldName)
        : [...prev, fieldName]
    );
  };

  const getFilteredRows = () => {
    const rows = activeTab === 'trans' ? transData : acctData;
    if (filters.length === 0) return rows;
    return rows.filter(row => filters.includes(row.name));
  };

  const renderTable = rows => (
    <div style={{ maxHeight: '50vh', overflow: 'auto', padding: '0 10%', boxSizing: 'border-box' }}>
      <DataTable borders="all" density="default">
        <DataTableHead>
          <DataTableRow>
            <DataTableHeadCell>Field Name</DataTableHeadCell>
            <DataTableHeadCell>Field Value</DataTableHeadCell>
            <DataTableHeadCell>Field Description</DataTableHeadCell>
            <DataTableHeadCell>System Source Name</DataTableHeadCell>
          </DataTableRow>
        </DataTableHead>
        <DataTableBody>
          {rows.map((row, idx) => (
            <DataTableRow key={idx}>
              <DataTableCell>{row.name}</DataTableCell>
              <DataTableCell>{row.value}</DataTableCell>
              <DataTableCell>{row.description}</DataTableCell>
              <DataTableCell>{row.source}</DataTableCell>
            </DataTableRow>
          ))}
        </DataTableBody>
      </DataTable>
    </div>
  );

  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'center', gap: '30px', marginTop: '40px' }}>
        <Button
          variant={activeTab === 'trans' ? 'secondary' : 'primary'}
          onClick={() => handleToggle('trans')}
        >
          Transaction Codes
        </Button>
        <Button
          variant={activeTab === 'acct' ? 'secondary' : 'primary'}
          onClick={() => handleToggle('acct')}
        >
          Account Status Codes
        </Button>
      </div>

      <br />

      {activeTab && (
        <div style={{ display: 'flex', gap: '16px', justifyContent: 'center' }}>
          <IconDownload
            filled={true}
            title="Download JSON"
            titleId="download-icon"
            onClick={handleDownload}
            style={{ cursor: 'pointer' }}
          />
          <FilterMenu
            filters={filters}
            onChange={handleFilterChange}
            columns={(activeTab === 'trans' ? transData : acctData).map(row => row.name)}
          />
        </div>
      )}

      <br />

      {activeTab === 'trans' && renderTable(getFilteredRows())}
      {activeTab === 'acct' && renderTable(getFilteredRows())}
    </div>
  );
};

export default TabbedTables;