```
// Create CSV content
let csvContent = headers.map(h => `"${h}"`).join(',') + '\n';

filteredData.forEach(row => {
  const isGlobestar = row.source.toLowerCase().includes('globestar');
  const rowData = Object.keys(activeColumnLabels)
    .filter(key => visibleColumns[key] && (showGlobestarColumns || (key !== 'blockCode1' && key !== 'blockCode2')))
    .map(key => {
      // Return empty string for block codes in non-Globestar rows
      if ((key === 'blockCode1' || key === 'blockCode2') && !isGlobestar) {
        return '';
      }
      const value = row[key] || '';
      // Escape quotes and wrap in quotes if contains comma, quote, or newline
      const escaped = value.toString().replace(/"/g, '""');
      return /[",\n]/.test(escaped) ? `"${escaped}"` : escaped;
    });
  csvContent += rowData.join(',') + '\n';
});

const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
const url = URL.createObjectURL(blob);
const link = document.createElement('a');
link.href = url;
link.download = `transaction_codes_${new Date().toISOString().slice(0, 10)}.csv`;
document.body.appendChild(link);
link.click();
document.body.removeChild(link);
URL.revokeObjectURL(url);
setShowDownloadMenu(false);
