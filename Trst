import React, { useState, useEffect } from 'react';
import { Button } from '@americanexpress/dls-react';
import IconDownload from '@americanexpress/dls-icons/dist/system/IconDownload';
import IconFilter from '@americanexpress/dls-icons/dist/system/IconFilter';
import FilterMenu from './FilterMenu';
import triumphTransData from '../data/Triumph_Trans_Codes.json';
import triumphStatusData from '../data/Triumph_Status_Codes.json';

const TabbedTables = () => {
  const [activeTab, setActiveTab] = useState('trans');
  const [filters, setFilters] = useState(['name', 'value', 'description', 'source']);
  const [fieldFilters, setFieldFilters] = useState({
    name: '',
    value: '',
    description: '',
    source: '',
  });
  const [showFilterMenu, setShowFilterMenu] = useState(false);
  const [showDownloadMenu, setShowDownloadMenu] = useState(false);

  const transData = triumphTransData.Triumph_Trans_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const acctData = triumphStatusData.Triumph_Status_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const data = activeTab === 'trans' ? transData : acctData;

  const handleToggle = (tab) => {
    setActiveTab((prev) => (prev === tab ? null : tab));
    setShowDownloadMenu(false);
    setShowFilterMenu(false);
    setFieldFilters({ name: '', value: '', description: '', source: '' });
  };

  const getFilteredData = () => {
    return data
      .filter((row) =>
        Object.entries(fieldFilters).every(([key, value]) =>
          row[key].toLowerCase().includes(value.toLowerCase())
        )
      )
      .map((row) => {
        const filteredRow = {};
        filters.forEach((key) => {
          filteredRow[key] = row[key];
        });
        return filteredRow;
      });
  };

  const downloadData = (type) => {
    const filtered = getFilteredData();
    const blob =
      type === 'json'
        ? new Blob([JSON.stringify(filtered, null, 2)], { type: 'application/json' })
        : new Blob(
            [
              [filters.join(','), ...filtered.map((row) => filters.map((f) => row[f]).join(','))].join('\n'),
            ],
            { type: 'text/csv' }
          );

    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `filtered_data.${type}`;
    link.click();
    URL.revokeObjectURL(url);
  };

  const getSuggestions = (columnKey) => {
    const uniqueValues = [...new Set(data.map((item) => item[columnKey]))];
    const inputValue = fieldFilters[columnKey].toLowerCase();
    return uniqueValues.filter((val) => val.toLowerCase().includes(inputValue));
  };

  return (
    <div style={{ padding: '20px' }}>
      <div style={{ display: 'flex', justifyContent: 'center', gap: '30px', marginTop: '20px' }}>
        <Button variant={activeTab === 'trans' ? 'secondary' : 'primary'} onClick={() => handleToggle('trans')}>
          Transaction Codes
        </Button>
        <Button variant={activeTab === 'acct' ? 'secondary' : 'primary'} onClick={() => handleToggle('acct')}>
          Account Status Codes
        </Button>
      </div>

      {activeTab && (
        <>
          <div style={{ display: 'flex', gap: '16px', marginTop: '20px', justifyContent: 'center' }}>
            {['name', 'value', 'description', 'source'].map((key) => (
              <div key={key} style={{ position: 'relative' }}>
                <input
                  type="text"
                  placeholder={`Filter ${key.charAt(0).toUpperCase() + key.slice(1)}...`}
                  value={fieldFilters[key]}
                  onChange={(e) =>
                    setFieldFilters((prev) => ({
                      ...prev,
                      [key]: e.target.value,
                    }))
                  }
                  style={{
                    padding: '8px',
                    width: '200px',
                    border: '1px solid #ccc',
                    borderRadius: '4px',
                  }}
                />
                {fieldFilters[key] && (
                  <ul
                    style={{
                      position: 'absolute',
                      top: '36px',
                      left: 0,
                      zIndex: 1,
                      backgroundColor: 'white',
                      listStyle: 'none',
                      padding: 0,
                      margin: 0,
                      width: '100%',
                      maxHeight: '150px',
                      overflowY: 'auto',
                      border: '1px solid #ccc',
                      borderTop: 'none',
                    }}
                  >
                    {getSuggestions(key).map((suggestion, idx) => (
                      <li
                        key={idx}
                        onClick={() =>
                          setFieldFilters((prev) => ({
                            ...prev,
                            [key]: suggestion,
                          }))
                        }
                        style={{
                          padding: '8px',
                          cursor: 'pointer',
                        }}
                      >
                        {suggestion}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>

          <div style={{ display: 'flex', gap: '12px', marginTop: '20px', justifyContent: 'center' }}>
            <IconDownload
              filled
              title="Download"
              onClick={() => {
                setShowDownloadMenu((prev) => !prev);
                setShowFilterMenu(false);
              }}
            />
            <IconFilter
              filled
              title="Filter"
              onClick={() => {
                setShowFilterMenu((prev) => !prev);
                setShowDownloadMenu(false);
              }}
            />
          </div>

          {showDownloadMenu && (
            <div style={{ textAlign: 'center', marginTop: '10px' }}>
              <button onClick={() => downloadData('json')}>Download JSON</button>
              <button onClick={() => downloadData('csv')}>Download CSV</button>
            </div>
          )}

          {showFilterMenu && (
            <FilterMenu
              filters={filters}
              setFilters={setFilters}
              onApply={() => setShowFilterMenu(false)}
              onReset={() => {
                setFilters(['name', 'value', 'description', 'source']);
                setFieldFilters({ name: '', value: '', description: '', source: '' });
              }}
            />
          )}

          <table style={{ width: '100%', marginTop: '30px', borderCollapse: 'collapse' }}>
            <thead>
              <tr>
                {filters.map((key) => (
                  <th
                    key={key}
                    style={{
                      textAlign: 'left',
                      padding: '10px',
                      borderBottom: '2px solid #ccc',
                    }}
                  >
                    {`Field ${key.charAt(0).toUpperCase() + key.slice(1)}`}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {getFilteredData().map((row, idx) => (
                <tr key={idx}>
                  {filters.map((key) => (
                    <td key={key} style={{ padding: '10px', borderBottom: '1px solid #eee' }}>
                      {row[key]}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}
    </div>
  );
};

export default TabbedTables;