      const rowValue = (row[key] || '').toLowerCase();
      return rowValue.includes(filterValue);
    }
    
    // For all other fields, apply filter normally
    const rowValue = (row[key] || '').toLowerCase();
    return rowValue.includes(filterValue);
  });
  
  return passesFilters;
