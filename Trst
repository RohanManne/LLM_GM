import React from 'react';
import { Menu, MenuItem } from '@americanexpress/dls-react';

const ALL_FIELDS = ['name', 'value', 'description', 'source'];

const FilteredMenu = ({ filters, setFilters }) => {
  const toggleFilter = (field) => {
    if (filters.includes(field)) {
      setFilters(filters.filter((f) => f !== field));
    } else {
      setFilters([...filters, field]);
    }
  };

  return (
    <div style={{ display: 'inline-block', marginBottom: '1rem' }}>
      <Menu label="Filter Columns">
        {ALL_FIELDS.map((field) => (
          <MenuItem key={field}>
            <label style={{ display: 'flex', alignItems: 'center' }}>
              <input
                type="checkbox"
                checked={filters.includes(field)}
                onChange={() => toggleFilter(field)}
                style={{ marginRight: '8px' }}
              />
              {field}
            </label>
          </MenuItem>
        ))}
      </Menu>
    </div>
  );
};

export default FilteredMenu;

import React, { useState, useMemo } from 'react';
import FilteredMenu from './FilteredMenu';

const TABS = ['Trans Code', 'Account Status Code', 'Fact Code'];

const sampleData = [
  {
    name: 'EXAMPLE',
    value: '001',
    description: 'Sample description',
    source: 'Source A',
  },
  // Add more rows here
];

const TabbedTables = () => {
  const [activeTab, setActiveTab] = useState('Trans Code');
  const [filters, setFilters] = useState(['name', 'value', 'description', 'source']);

  const filteredData = useMemo(() => {
    return sampleData.map((row) => {
      const filteredRow = {};
      filters.forEach((key) => {
        filteredRow[key] = row[key];
      });
      return filteredRow;
    });
  }, [filters]);

  return (
    <div style={{ padding: '1rem' }}>
      <div style={{ marginBottom: '1rem' }}>
        {TABS.map((tab) => (
          <button
            key={tab}
            onClick={() => setActiveTab(tab)}
            style={{
              marginRight: '8px',
              padding: '6px 12px',
              backgroundColor: activeTab === tab ? '#0070f3' : '#eee',
              color: activeTab === tab ? '#fff' : '#000',
              border: 'none',
              borderRadius: '4px',
              cursor: 'pointer',
            }}
          >
            {tab}
          </button>
        ))}
      </div>

      <FilteredMenu filters={filters} setFilters={setFilters} />

      <table style={{ width: '100%', borderCollapse: 'collapse' }}>
        <thead>
          <tr>
            {filters.map((key) => (
              <th
                key={key}
                style={{
                  borderBottom: '1px solid #ccc',
                  textAlign: 'left',
                  padding: '8px',
                }}
              >
                {key.toUpperCase()}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {filteredData.map((row, idx) => (
            <tr key={idx}>
              {filters.map((key) => (
                <td
                  key={key}
                  style={{
                    borderBottom: '1px solid #eee',
                    padding: '8px',
                  }}
                >
                  {row[key]}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
};

export default TabbedTables;