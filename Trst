import React, { useState, useMemo, useCallback, useRef, useEffect } from 'react';
import transactionData from './Triumph_Trans_Codes.json';
import * as XLSX from 'xlsx';

const TransactionCodes = () => {
  const [filters, setFilters] = useState({
    name: '',
    blockCode1: '',
    blockCode2: '',
    marketLocation: '',
    batchCode: '',
    subCode: '',
    value: '',
    description: '',
    source: '',
  });

  const [currentPage, setCurrentPage] = useState(1);
  const rowsPerPage = 8;

  const [visibleColumns, setVisibleColumns] = useState({
    name: true,
    blockCode1: true,
    blockCode2: true,
    batchCode: true,
    subCode: true,
    value: true,
    description: true,
    source: true,
  });

  const [showColumnToggle, setShowColumnToggle] = useState(false);
  const columnToggleRef = useRef(null);

  const [showDownloadMenu, setShowDownloadMenu] = useState(false);
  const downloadMenuRef = useRef(null);

  const [sourceFilterMode, setSourceFilterMode] = useState('all');

  const [activeDropdown, setActiveDropdown] = useState(null);
  const [dropdownSuggestions, setDropdownSuggestions] = useState({});
  const dropdownRefs = useRef({});
  const [inputValues, setInputValues] = useState({});

  const columnLabelsAll = {
    name: 'Field Name',
    blockCode1: 'Block Code 1',
    blockCode2: 'Block Code 2',
    marketLocation: 'Market Location',
    batchCode: 'Batch Code',
    subCode: 'Sub Code',
    value: 'Field Value',
    description: 'Field Description',
    source: 'System Source Name',
  };

  const columnLabelsGlobestar = {
    name: 'Field Name',
    blockCode1: 'Block Code 1',
    blockCode2: 'Block Code 2',
    marketLocation: 'Market Location',
    value: 'Field Value',
    description: 'Field Description',
    source: 'System Source Name',
  };

  const columnLabelsTriumph = {
    name: 'Field Name',
    marketLocation: 'Market Location',
    value: 'Field Value',
    description: 'Field Description',
    source: 'System Source Name',
  };

  const columnLabelsCARS = {
    name: 'Field Name',
    marketLocation: 'Market Location',
    batchCode: 'Batch Code',
    subCode: 'Sub Code',
    value: 'Field Value',
    description: 'Field Description',
    source: 'System Source Name',
  };

  const transData = useMemo(
    () =>
      transactionData.Triumph_Trans_Codes.map((item) => ({
        name: item['Field Name'] || '',
        blockCode1: item['Block Code 1'] || '',
        blockCode2: item['Block Code 2'] || '',
        marketLocation: item['Market Location'] || '',
        batchCode: item['Batch Code'] || '',
        subCode: item['Sub Code'] || '',
        value: item['Field Value'] || '',
        description: item['Field Description'] || '',
        source: item['System Source Name'] || '',
      })),
    []
  );

  const uniqueValues = useMemo(() => {
    const keys = Object.keys(columnLabelsAll);
    const uniq = {};
    keys.forEach((k) => {
      uniq[k] = [...new Set(transData.map((i) => i[k]))].filter(Boolean).sort();
    });
    return uniq;
  }, [transData]);

  const debounce = (fn, delay) => {
    let timer;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  };

  const debouncedSetFilters = useCallback(
    debounce((field, value) => {
      setFilters((prev) => ({ ...prev, [field]: value }));
    }, 300),
    []
  );

  const handleFilterChange = (field, value) => {
    setInputValues((prev) => ({ ...prev, [field]: value }));
    debouncedSetFilters(field, value);

    if (value.trim()) {
      const suggestions = (uniqueValues[field] || [])
        .filter((v) => v.toLowerCase().includes(value.toLowerCase()))
        .slice(0, 10);
      setDropdownSuggestions((prev) => ({ ...prev, [field]: suggestions }));
      setActiveDropdown(field);
    } else {
      setActiveDropdown(null);
    }
  };

  const handleSuggestionClick = (field, val) => {
    setInputValues((prev) => ({ ...prev, [field]: val }));
    setFilters((prev) => ({ ...prev, [field]: val }));
    setActiveDropdown(null);
  };

  const handleInputFocus = (field) => {
    const val = inputValues[field] || '';
    if (val.trim()) {
      const suggestions = (uniqueValues[field] || [])
        .filter((v) => v.toLowerCase().includes(val.toLowerCase()))
        .slice(0, 10);
      setDropdownSuggestions((prev) => ({ ...prev, [field]: suggestions }));
      setActiveDropdown(field);
    }
  };

  const toggleColumn = (key) => {
    if (key === 'marketLocation') return;
    setVisibleColumns((prev) => ({ ...prev, [key]: !prev[key] }));
  };

  const activeColumnLabels = useMemo(() => {
    switch (sourceFilterMode) {
      case 'globestar':
        return columnLabelsGlobestar;
      case 'triumph':
        return columnLabelsTriumph;
      case 'cars':
        return columnLabelsCARS;
      default:
        return columnLabelsAll;
    }
  }, [sourceFilterMode]);

  const filteredData = useMemo(() => {
    return transData.filter((row) => {
      const src = row.source.toLowerCase();
      if (sourceFilterMode === 'globestar' && !src.includes('globestar')) return false;
      if (sourceFilterMode === 'triumph' && !src.includes('triumph')) return false;
      if (sourceFilterMode === 'cars' && !src.includes('cars')) return false;

      return Object.entries(filters).every(([k, v]) => {
        if (!v) return true;
        return row[k]?.toLowerCase().includes(v.toLowerCase());
      });
    });
  }, [filters, transData, sourceFilterMode]);

  const totalPages = Math.ceil(filteredData.length / rowsPerPage) || 1;
  const startIndex = (currentPage - 1) * rowsPerPage;
  const endIndex = startIndex + rowsPerPage;
  const currentData = filteredData.slice(startIndex, endIndex);

  useEffect(() => setCurrentPage(1), [filters, sourceFilterMode]);

  useEffect(() => {
    const handleClickOutside = (e) => {
      if (showDownloadMenu && downloadMenuRef.current && !downloadMenuRef.current.contains(e.target)) setShowDownloadMenu(false);
      if (showColumnToggle && columnToggleRef.current && !columnToggleRef.current.contains(e.target)) setShowColumnToggle(false);
      if (activeDropdown && dropdownRefs.current[activeDropdown] && !dropdownRefs.current[activeDropdown].contains(e.target)) setActiveDropdown(null);
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, [activeDropdown, showColumnToggle, showDownloadMenu]);

  const getPageNumbers = () => {
    const pages = [];
    const max = 5;
    if (totalPages <= max) for (let i = 1; i <= totalPages; i++) pages.push(i);
    else if (currentPage <= 3) pages.push(1, 2, 3, 4, '...', totalPages);
    else if (currentPage >= totalPages - 2) pages.push(1, '...', totalPages - 3, totalPages - 2, totalPages - 1, totalPages);
    else pages.push(1, '...', currentPage - 1, currentPage, currentPage + 1, '...', totalPages);
    return pages;
  };

  const visibleKeys = Object.keys(activeColumnLabels);

  const downloadAsJSON = () => {
    const visibleData = filteredData.map((row) => {
      const result = {};
      Object.entries(activeColumnLabels).forEach(([k, label]) => {
        if (k !== 'marketLocation' && !visibleColumns[k]) return;
        result[label] = row[k] || '';
      });
      return result;
    });
    const blob = new Blob([JSON.stringify(visibleData, null, 2)], { type: 'application/json' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'transaction_codes.json';
    link.click();
  };

  const downloadAsCSV = () => {
    const headers = Object.entries(activeColumnLabels)
      .filter(([k]) => k === 'marketLocation' || visibleColumns[k])
      .map(([, l]) => l)
      .join(',');
    const rows = filteredData.map((r) =>
      Object.keys(activeColumnLabels)
        .filter((k) => k === 'marketLocation' || visibleColumns[k])
        .map((k) => `"${(r[k] || '').replace(/"/g, '""')}"`)
        .join(',')
    );
    const csv = [headers, ...rows].join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'transaction_codes.csv';
    link.click();
  };

  const downloadAsExcel = () => {
    const visibleData = filteredData.map((row) => {
      const obj = {};
      Object.entries(activeColumnLabels).forEach(([k, label]) => {
        if (k !== 'marketLocation' && !visibleColumns[k]) return;
        obj[label] = row[k] || '';
      });
      return obj;
    });
    const ws = XLSX.utils.json_to_sheet(visibleData);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Transaction Codes');
    XLSX.writeFile(wb, 'transaction_codes.xlsx');
  };

  return (
    <div className="transaction-codes-container pad-2 border">
      {/* Header */}
      <div className="header-section flex flex-justify-between flex-align-end margin-2-b pad-1-b border-bottom">
        <div>
          <h2 className="margin-0 font-weight-bold">Transaction Codes</h2>
          <p className="text-neutral font-italic margin-0">
            Enterprise Catalog Business Term Definition: DEFINITION
          </p>
        </div>

        <div className="flex flex-align-center stack-1-r">
          <select
            className="border pad-1-t-b pad-1-l-r"
            value={sourceFilterMode}
            onChange={(e) => setSourceFilterMode(e.target.value)}
          >
            <option value="all">All Sources</option>
            <option value="globestar">Globestar Only</option>
            <option value="triumph">Triumph Only</option>
            <option value="cars">CARS Only</option>
          </select>

          {/* Download */}
          <div className="position-relative" ref={downloadMenuRef}>
            <button
              className="border pad-1-t-b pad-1-l-r flex flex-align-center"
              onClick={() => setShowDownloadMenu(!showDownloadMenu)}
            >
              <span>⬇</span>
              <span className="margin-1-l">Download</span>
            </button>

            {showDownloadMenu && (
              <div className="position-absolute-tr margin-1-t border border-dark pad-1 bg-white z-30 z-20 z-10 layer-3 layer-foreground">
                <div className="font-weight-bold pad-1 border-bottom margin-0">
                  Export Format
                </div>
                <button className="display-block pad-1 text-align-left border-0" onClick={downloadAsExcel}>
                  📗 <span className="margin-1-l">Download as Excel</span>
                </button>
                <button className="display-block pad-1 text-align-left border-0" onClick={downloadAsCSV}>
                  📊 <span className="margin-1-l">Download as CSV</span>
                </button>
                <button className="display-block pad-1 text-align-left border-0" onClick={downloadAsJSON}>
                  📄 <span className="margin-1-l">Download as JSON</span>
                </button>
              </div>
            )}
          </div>

          {/* Column Toggle */}
          <div className="position-relative" ref={columnToggleRef}>
            <button
              className="border pad-1-t-b pad-1-l-r flex flex-align-center"
              onClick={() => setShowColumnToggle(!showColumnToggle)}
            >
              <span>⚙️</span>
              <span className="margin-1-l">Columns</span>
            </button>

            {showColumnToggle && (
              <div className="position-absolute-tr margin-1-t border border-dark pad-1 bg-white z-30 z-20 z-10 layer-3 layer-foreground">
                <div className="font-weight-bold pad-1 border-bottom margin-0">
                  Show/Hide Columns
                </div>
                {Object.entries(activeColumnLabels).map(([key, label]) =>
                  key === 'marketLocation' ? (
                    <label key={key} className="display-block pad-1 text-neutral">
                      <input type="checkbox" checked readOnly disabled className="margin-1-r" />
                      {label}
                    </label>
                  ) : (
                    <label key={key} className="display-block pad-1">
                      <input
                        type="checkbox"
                        className="margin-1-r"
                        checked={!!visibleColumns[key]}
                        onChange={() => toggleColumn(key)}
                      />
                      {label}
                    </label>
                  )
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      {/* Table */}
      <table className="width-full border">
        <thead>
          <tr>
            {visibleKeys.map((k) => (
              <th key={k} className="font-weight-bold text-uppercase pad-1-l-r pad-1-t-b border-bottom">
                {activeColumnLabels[k]}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {/* Filter Row */}
          <tr>
            {visibleKeys.map((k) => (
              <td key={`filter-${k}`} className="pad-1 position-relative border">
                <div className="position-relative width-full" ref={(el) => (dropdownRefs.current[k] = el)}>
                  <input
                    type="text"
                    className="width-full border pad-1"
                    value={inputValues[k] || ''}
                    onChange={(e) => handleFilterChange(k, e.target.value)}
                    onFocus={() => handleInputFocus(k)}
                    placeholder={`Filter ${activeColumnLabels[k]}`}
                  />
                  {activeDropdown === k && dropdownSuggestions[k]?.length > 0 && (
                    <div className="border width-full margin-1-t position-absolute bg-white z-30 z-20 z-10 layer-3 layer-foreground">
                      {dropdownSuggestions[k].map((s, i) => (
                        <div key={i} className="pad-1" onClick={() => handleSuggestionClick(k, s)}>
                          {s}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </td>
            ))}
          </tr>

          {/* Data Rows */}
          {currentData.map((row, i) => (
            <tr key={`row-${i}`}>
              {visibleKeys.map((k) => (
                <td key={`${i}-${k}`} className="pad-1-l-r pad-1-t-b border">
                  {row[k] || (k === 'marketLocation' ? '-' : '')}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>

      {!filteredData.length && (
        <div className="margin-1-t text-neutral font-italic">No Transaction Codes To Be Displayed</div>
      )}

      {filteredData.length > 0 && (
        <div className="flex flex-justify-between flex-align-center margin-2-t stack-1-r">
          <div>
            Showing rows {startIndex + 1}-{Math.min(endIndex, filteredData.length)} of {filteredData.length}
          </div>
          <div className="flex">
            <button className="border pad-1-l-r pad-1-t-b margin-0" onClick={() => setCurrentPage(1)} disabled={currentPage === 1}>First</button>
            <button className="border pad-1-l-r pad-1-t-b margin-0" onClick={() => setCurrentPage(p => Math.max(1, p - 1))} disabled={currentPage === 1}>Previous</button>
            {getPageNumbers().map((p, idx) =>
              p === '...' ? (
                <span key={idx} className="margin-1-l-r text-neutral">…</span>
              ) : (
                <button key={p} className={`border pad-1-l-r pad-1-t-b margin-0 ${currentPage === p ? 'font-weight-bold' : ''}`} onClick={() => setCurrentPage(p)}>
                  {p}
                </button>
              )
            )}
            <button className="border pad-1-l-r pad-1-t-b margin-0" onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))} disabled={currentPage === totalPages}>Next</button>
            <button className="border pad-1-l-r pad-1-t-b margin-0" onClick={() => setCurrentPage(totalPages)} disabled={currentPage === totalPages}>Last</button>
          </div>
        </div>
      )}
    </div>
  );
};

export default TransactionCodes;