import React, { useState, useMemo, useCallback, useRef, useEffect } from 'react';
import transactionData from './Triumph_Trans_Codes.json';
import * as XLSX from 'xlsx';

const TransactionCodes = () => {
  const [filters, setFilters] = useState({
    name: '',
    blockCode1: '',
    blockCode2: '',
    marketLocation: '',
    value: '',
    description: '',
    source: '',
  });

  const [currentPage, setCurrentPage] = useState(1);
  const rowsPerPage = 8;

  // Column visibility
  const [visibleColumns, setVisibleColumns] = useState({
    name: true,
    blockCode1: true,
    blockCode2: true,
    marketLocation: true, // Always available by default
    value: true,
    description: true,
    source: true,
  });

  const [showColumnToggle, setShowColumnToggle] = useState(false);
  const columnToggleRef = useRef(null);

  const [showDownloadMenu, setShowDownloadMenu] = useState(false);
  const downloadMenuRef = useRef(null);

  // 'all' | 'globestar' | 'non-globestar'
  const [sourceFilterMode, setSourceFilterMode] = useState('all');

  // Labels (order matters → iteration preserves insertion order)
  const columnLabelsGlobestar = {
    name: 'Field Name',
    blockCode1: 'Block Code 1',
    blockCode2: 'Block Code 2',
    marketLocation: 'Market Location', // ← always before Field Value
    value: 'Field Value',
    description: 'Field Description',
    source: 'System Source Name',
  };

  const columnLabelsStandard = {
    name: 'Field Name',
    marketLocation: 'Market Location', // ← always before Field Value
    value: 'Field Value',
    description: 'Field Description',
    source: 'System Source Name',
  };

  const [activeDropdown, setActiveDropdown] = useState(null);
  const [dropdownSuggestions, setDropdownSuggestions] = useState({
    name: [],
    blockCode1: [],
    blockCode2: [],
    marketLocation: [],
    value: [],
    description: [],
    source: [],
  });

  const dropdownRefs = useRef({});

  // Separate input values for debouncing
  const [inputValues, setInputValues] = useState({
    name: '',
    blockCode1: '',
    blockCode2: '',
    marketLocation: '',
    value: '',
    description: '',
    source: '',
  });

  // Transform data once
  const transData = useMemo(
    () =>
      transactionData.Triumph_Trans_Codes.map((item) => ({
        name: item['Field Name'] || '',
        blockCode1: item['Block Code 1'] || '',
        blockCode2: item['Block Code 2'] || '',
        marketLocation: item['Market Location'] || '', // ← new field
        value: item['Field Value'] || '',
        description: item['Field Description'] || '',
        source: item['System Source Name'] || '',
      })),
    []
  );

  // Unique values for suggestions
  const uniqueValues = useMemo(
    () => ({
      name: [...new Set(transData.map((item) => item.name))].filter(Boolean).sort(),
      blockCode1: [
        ...new Set(
          transData
            .filter((item) => (item.source || '').toLowerCase().includes('globestar'))
            .map((item) => item.blockCode1)
        ),
      ]
        .filter(Boolean)
        .sort(),
      blockCode2: [
        ...new Set(
          transData
            .filter((item) => (item.source || '').toLowerCase().includes('globestar'))
            .map((item) => item.blockCode2)
        ),
      ]
        .filter(Boolean)
        .sort(),
      marketLocation: [...new Set(transData.map((item) => item.marketLocation))].filter(Boolean).sort(),
      value: [...new Set(transData.map((item) => item.value))].filter(Boolean).sort(),
      description: [...new Set(transData.map((item) => item.description))].filter(Boolean).sort(),
      source: [...new Set(transData.map((item) => item.source))].filter(Boolean).sort(),
    }),
    [transData]
  );

  // Apply filters
  const filteredData = useMemo(() => {
    const filtered = transData.filter((row) => {
      const isGlobestar = (row.source || '').toLowerCase().includes('globestar');

      // Source mode first
      if (sourceFilterMode === 'globestar' && !isGlobestar) return false;
      if (sourceFilterMode === 'non-globestar' && isGlobestar) return false;

      // Field-by-field filters
      return Object.entries(filters).every(([key, val]) => {
        if (!val || !val.trim()) return true;
        return (row[key] || '').toLowerCase().includes(val.trim().toLowerCase());
      });
    });

    return filtered;
  }, [transData, filters, sourceFilterMode]);

  // ---- Sticky Globestar columns logic (with Non-Globestar priority) ----
  const hasGlobestarInDataset = useMemo(
    () => transData.some((item) => (item.source || '').toLowerCase().includes('globestar')),
    [transData]
  );

  const showGlobestarColumns = useMemo(() => {
    // Highest priority: Non-Globestar must HIDE Block Code columns
    if (sourceFilterMode === 'non-globestar') return false;

    // Next: Globestar Only must SHOW Block Code columns
    if (sourceFilterMode === 'globestar') return true;

    // Otherwise, sticky behavior
    if ((inputValues.blockCode1 || '').trim() || (inputValues.blockCode2 || '').trim()) return true;
    if (filteredData.some((item) => (item.source || '').toLowerCase().includes('globestar'))) return true;

    // Or keep available if dataset contains any Globestar rows (optional)
    return hasGlobestarInDataset;
  }, [
    sourceFilterMode,
    inputValues.blockCode1,
    inputValues.blockCode2,
    filteredData,
    hasGlobestarInDataset,
  ]);

  // When switching to Non-Globestar, clear block-code filters/inputs
  useEffect(() => {
    if (sourceFilterMode === 'non-globestar') {
      setFilters((prev) => ({ ...prev, blockCode1: '', blockCode2: '' }));
      setInputValues((prev) => ({ ...prev, blockCode1: '', blockCode2: '' }));
      setActiveDropdown(null);
    }
  }, [sourceFilterMode]);
  // ---------------------------------------------------------------------

  const activeColumnLabels = showGlobestarColumns ? columnLabelsGlobestar : columnLabelsStandard;

  // Pagination
  const totalPages = Math.ceil(filteredData.length / rowsPerPage) || 1;
  const startIndex = (currentPage - 1) * rowsPerPage;
  const endIndex = startIndex + rowsPerPage;
  const currentData = filteredData.slice(startIndex, endIndex);

  // Reset page on filter changes
  useEffect(() => {
    setCurrentPage(1);
  }, [filters, sourceFilterMode]);

  // Debounce utility
  const debounce = (func, wait) => {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  };

  const debouncedSetFilters = useCallback(
    debounce((field, value) => {
      setFilters((prev) => ({ ...prev, [field]: value }));
    }, 300),
    []
  );

  const handleFilterChange = (field, value) => {
    setInputValues((prev) => ({ ...prev, [field]: value }));
    debouncedSetFilters(field, value);

    // Suggestions
    if (value.trim()) {
      const suggestions = (uniqueValues[field] || [])
        .filter((item) => item.toLowerCase().includes(value.toLowerCase()))
        .slice(0, 10);

      setDropdownSuggestions((prev) => ({
        ...prev,
        [field]: suggestions,
      }));
      setActiveDropdown(field);
    } else {
      setActiveDropdown(null);
    }
  };

  const handleSuggestionClick = (field, value) => {
    setInputValues((prev) => ({ ...prev, [field]: value }));
    setFilters((prev) => ({ ...prev, [field]: value }));
    setActiveDropdown(null);
  };

  const handleInputFocus = (field) => {
    if (inputValues[field] && inputValues[field].trim()) {
      const suggestions = (uniqueValues[field] || [])
        .filter((item) => item.toLowerCase().includes(inputValues[field].toLowerCase()))
        .slice(0, 10);

      setDropdownSuggestions((prev) => ({
        ...prev,
        [field]: suggestions,
      }));
      setActiveDropdown(field);
    }
  };

  const toggleColumn = (column) => {
    setVisibleColumns((prev) => ({
      ...prev,
      [column]: !prev[column],
    }));
  };

  // Downloads
  const downloadAsJSON = () => {
    const visibleData = filteredData.map((row) => {
      const visibleRow = {};
      const isGlobestar = (row.source || '').toLowerCase().includes('globestar');
      const columnsToUse = isGlobestar ? columnLabelsGlobestar : columnLabelsStandard;

      Object.entries(columnsToUse).forEach(([key, label]) => {
        if (!visibleColumns[key]) return;
        if ((key === 'blockCode1' || key === 'blockCode2') && !isGlobestar) return;
        visibleRow[label] = row[key] || '';
      });

      return visibleRow;
    });

    const jsonString = JSON.stringify(visibleData, null, 2);
    const blob = new Blob([jsonString], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `transaction_codes_${new Date().toISOString().slice(0, 10)}.json`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    setShowDownloadMenu(false);
  };

  const downloadAsCSV = () => {
    const headers = Object.entries(activeColumnLabels)
      .filter(([key]) => visibleColumns[key] && (showGlobestarColumns || (key !== 'blockCode1' && key !== 'blockCode2')))
      .map(([, label]) => label);

    let csvContent = headers.map((h) => `"${h}"`).join(',') + '\n';

    filteredData.forEach((row) => {
      const isGlobestar = (row.source || '').toLowerCase().includes('globestar');
      const rowData = Object.keys(activeColumnLabels)
        .filter((key) => visibleColumns[key] && (showGlobestarColumns || (key !== 'blockCode1' && key !== 'blockCode2')))
        .map((key) => {
          if ((key === 'blockCode1' || key === 'blockCode2') && !isGlobestar) return '';
          const value = row[key] || '';
          const escaped = value.toString().replace(/"/g, '""');
          return /[",\n]/.test(escaped) ? `"${escaped}"` : escaped;
        });

      csvContent += rowData.join(',') + '\n';
    });

    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `transaction_codes_${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
    setShowDownloadMenu(false);
  };

  const downloadAsExcel = () => {
    const excelData = filteredData.map((row) => {
      const visibleRow = {};
      const isGlobestar = (row.source || '').toLowerCase().includes('globestar');

     