import React from 'react';
import {
  FilterMenu,
  CheckboxGroup,
  Checkbox,
} from '@americanexpress/dls-react';

const ALL_FIELDS = [
  { id: 'name', label: 'Field Name' },
  { id: 'value', label: 'Field Value' },
  { id: 'description', label: 'Field Description' },
  { id: 'source', label: 'System Source Name' },
];

const ColumnFilterMenu = ({ filters, setFilters }) => {
  const handleToggle = (fieldId) => {
    setFilters((prev) =>
      prev.includes(fieldId)
        ? prev.filter((f) => f !== fieldId)
        : [...prev, fieldId]
    );
  };

  return (
    <FilterMenu
      id="column-filter"
      showResetButton={false}
      showApplyButton={false}
      iconButtonProps={{
        'aria-label': 'Toggle Column Filter',
        style: {
          border: '1px solid #ccc',
          borderRadius: '4px',
          padding: '6px',
        },
        filled: true,
      }}
    >
      <CheckboxGroup legend="Select Columns">
        {ALL_FIELDS.map(({ id, label }) => (
          <Checkbox
            key={id}
            id={`checkbox-${id}`}
            label={label}
            checked={filters.includes(id)}
            onChange={() => handleToggle(id)}
          />
        ))}
      </CheckboxGroup>
    </FilterMenu>
  );
};

export default ColumnFilterMenu;

import React, { useState, useMemo } from 'react';
import {
  DataTable,
  DataTableHead,
  DataTableBody,
  DataTableRow,
  DataTableCell,
  DataTableHeadCell,
  FilterMenu,
  Dropdown,
  DropdownItem,
  IconButton,
} from '@americanexpress/dls-react';
import { IconDownload, IconFilter } from '@americanexpress/dls-icons';

import triumphTransData from '../data/Triumph_Trans_Codes.json';
import triumphStatusData from '../data/Triumph_Status_Codes.json';

const ALL_FIELDS = ['name', 'value', 'description', 'source'];

const TabbedTables = () => {
  const [activeTab, setActiveTab] = useState(null);
  const [filters, setFilters] = useState(ALL_FIELDS);
  const [showFilterMenu, setShowFilterMenu] = useState(false);

  const transData = triumphTransData.Triumph_Trans_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const acctData = triumphStatusData.Triumph_Status_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    source: item['System Source Name'],
  }));

  const handleToggle = (tab) => {
    setActiveTab((prev) => (prev === tab ? null : tab));
  };

  const getFilteredRows = () => {
    const rows = activeTab === 'trans' ? transData : acctData;
    if (filters.length === 0) return rows;
    return rows.map((row) => {
      const filteredRow = {};
      filters.forEach((key) => {
        filteredRow[key] = row[key];
      });
      return filteredRow;
    });
  };

  const handleDownload = (format) => {
    const data = activeTab === 'trans' ? transData : acctData;
    let content;
    let filename;

    if (format === 'json') {
      content = JSON.stringify(data, null, 2);
      filename = activeTab === 'trans' ? 'Transaction_Codes.json' : 'Account_Status_Codes.json';
    } else {
      const headers = Object.keys(data[0]).join(',');
      const rows = data.map((obj) => Object.values(obj).map((val) => `"${val}"`).join(',')).join('\n');
      content = `${headers}\n${rows}`;
      filename = activeTab === 'trans' ? 'Transaction_Codes.csv' : 'Account_Status_Codes.csv';
    }

    const blob = new Blob([content], { type: 'text/plain' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const renderTable = (rows) => (
    <div style={{ maxHeight: '50vh', overflow: 'auto', padding: '0 10%', boxSizing: 'border-box' }}>
      <DataTable borders="all" density="default" tableLayout="auto">
        <DataTableHead>
          <DataTableRow>
            {filters.includes('name') && <DataTableHeadCell>Field Name</DataTableHeadCell>}
            {filters.includes('value') && <DataTableHeadCell>Field Value</DataTableHeadCell>}
            {filters.includes('description') && <DataTableHeadCell>Field Description</DataTableHeadCell>}
            {filters.includes('source') && <DataTableHeadCell>System Source Name</DataTableHeadCell>}
          </DataTableRow>
        </DataTableHead>
        <DataTableBody>
          {rows.map((row, i) => (
            <DataTableRow key={i}>
              {filters.includes('name') && <DataTableCell>{row.name}</DataTableCell>}
              {filters.includes('value') && <DataTableCell>{row.value}</DataTableCell>}
              {filters.includes('description') && <DataTableCell>{row.description}</DataTableCell>}
              {filters.includes('source') && <DataTableCell>{row.source}</DataTableCell>}
            </DataTableRow>
          ))}
        </DataTableBody>
      </DataTable>
    </div>
  );

  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'center', gap: '30px', marginTop: '40px' }}>
        <button onClick={() => handleToggle('trans')} className={`dls-button ${activeTab === 'trans' ? 'dls-button--secondary' : 'dls-button--primary'}`}>
          Transaction Codes
        </button>
        <button onClick={() => handleToggle('acct')} className={`dls-button ${activeTab === 'acct' ? 'dls-button--secondary' : 'dls-button--primary'}`}>
          Account Status Codes
        </button>
      </div>

      {activeTab && (
        <div style={{ display: 'flex', justifyContent: 'center', gap: '12px', marginTop: '20px' }}>
          <Dropdown label={<IconDownload filled title="Download Options" />} variant="inline">
            <DropdownItem onClick={() => handleDownload('json')}>Download JSON</DropdownItem>
            <DropdownItem onClick={() => handleDownload('csv')}>Download CSV</DropdownItem>
          </Dropdown>

          <FilterMenu
            id="filter"
            filtersAppliedCount={filters.length}
            showMenu={showFilterMenu}
            onFilterButtonClick={() => setShowFilterMenu((prev) => !prev)}
            onMenuClose={() => setShowFilterMenu(false)}
            showResetButton
            showApplyButton
            onApplyButtonClick={() => setShowFilterMenu(false)}
            onResetButtonClick={() => setFilters([])}
          >
            <div style={{ padding: '12px' }}>
              {ALL_FIELDS.map((field) => (
                <label key={field} style={{ display: 'block', marginBottom: '6px' }}>
                  <input
                    type="checkbox"
                    checked={filters.includes(field)}
                    onChange={() =>
                      setFilters((prev) =>
                        prev.includes(field) ? prev.filter((f) => f !== field) : [...prev, field]
                      )
                    }
                    style={{ marginRight: '8px' }}
                  />
                  {field}
                </label>
              ))}
            </div>
          </FilterMenu>
        </div>
      )}

      {activeTab && renderTable(getFilteredRows())}
    </div>
  );
};

export default TabbedTables;