import React, { useState, useMemo, useCallback } from 'react';
import transactionData from './Triumph_Trans_Codes.json';

const TransactionCodes = () => {
  const [filters, setFilters] = useState({
    name: '',
    value: '',
    description: '',
    source: '',
  });

  const [currentPage, setCurrentPage] = useState(1);
  const rowsPerPage = 8;

  // Memoize the transformed data to avoid recreation on every render
  const transData = useMemo(() => 
    transactionData.Triumph_Trans_Codes.map((item) => ({
      name: item['Field Name'] || '',
      value: item['Field Value'] || '',
      description: item['Field Description'] || '',
      source: item['System Source Name'] || '',
    })), []
  );

  // Memoize filtered data with trimmed filter values
  const filteredData = useMemo(() => 
    transData.filter((row) =>
      Object.entries(filters).every(
        ([key, val]) => row[key].toLowerCase().includes(val.trim().toLowerCase())
      )
    ), [transData, filters]
  );

  // Calculate pagination
  const totalPages = Math.ceil(filteredData.length / rowsPerPage);
  const startIndex = (currentPage - 1) * rowsPerPage;
  const endIndex = startIndex + rowsPerPage;
  const currentData = filteredData.slice(startIndex, endIndex);

  // Reset to page 1 when filters change
  useMemo(() => {
    setCurrentPage(1);
  }, [filters]);

  // Debounce function to reduce filtering operations on large datasets
  const debounce = (func, wait) => {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  };

  // Create debounced filter handler
  const debouncedSetFilters = useCallback(
    debounce((field, value) => {
      setFilters((prev) => ({ ...prev, [field]: value }));
    }, 300),
    []
  );

  // State for input values (separate from filters for debouncing)
  const [inputValues, setInputValues] = useState({
    name: '',
    value: '',
    description: '',
    source: '',
  });

  const handleFilterChange = (field, value) => {
    // Update input immediately for responsive UI
    setInputValues((prev) => ({ ...prev, [field]: value }));
    // Debounce the actual filter update
    debouncedSetFilters(field, value);
  };

  // Generate page numbers to display
  const getPageNumbers = () => {
    const pages = [];
    const maxPagesToShow = 5;
    
    if (totalPages <= maxPagesToShow) {
      for (let i = 1; i <= totalPages; i++) {
        pages.push(i);
      }
    } else {
      if (currentPage <= 3) {
        for (let i = 1; i <= 4; i++) {
          pages.push(i);
        }
        pages.push('...');
        pages.push(totalPages);
      } else if (currentPage >= totalPages - 2) {
        pages.push(1);
        pages.push('...');
        for (let i = totalPages - 3; i <= totalPages; i++) {
          pages.push(i);
        }
      } else {
        pages.push(1);
        pages.push('...');
        pages.push(currentPage - 1);
        pages.push(currentPage);
        pages.push(currentPage + 1);
        pages.push('...');
        pages.push(totalPages);
      }
    }
    return pages;
  };

  return (
    <div className="transaction-codes-container">
      <h2>Transaction Codes</h2>
      <br/>
      <table className="table border table-striped" data-toggle="datatable">
        <thead>
          {/* Header Row */}
          <tr>
            <th scope="col">Field Name</th>
            <th scope="col">Field Value</th>
            <th scope="col">Field Description</th>
            <th scope="col">System Source Name</th>
          </tr>
        </thead>
        <tbody>
          {/* Filter Input Row */}
          <tr className="filter-row">
            <td>
              <input
                type="text"
                className="form-control filter-input"
                value={inputValues.name}
                onChange={(e) => handleFilterChange('name', e.target.value)}
                placeholder="Filter Name"
                aria-label="Filter by Field Name"
              />
            </td>
            <td>
              <input
                type="text"
                className="form-control filter-input"
                value={inputValues.value}
                onChange={(e) => handleFilterChange('value', e.target.value)}
                placeholder="Filter Value"
                aria-label="Filter by Field Value"
              />
            </td>
            <td>
              <input
                type="text"
                className="form-control filter-input"
                value={inputValues.description}
                onChange={(e) =>
                  handleFilterChange('description', e.target.value)
                }
                placeholder="Filter Description"
                aria-label="Filter by Field Description"
              />
            </td>
            <td>
              <input
                type="text"
                className="form-control filter-input"
                value={inputValues.source}
                onChange={(e) => handleFilterChange('source', e.target.value)}
                placeholder="Filter Source"
                aria-label="Filter by System Source Name"
              />
            </td>
          </tr>
          {currentData.map((row, idx) => (
            <tr key={`trans-code-${startIndex + idx}`}>
              <td>{row.name}</td>
              <td>{row.value}</td>
              <td>{row.description}</td>
              <td>{row.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
      
      {filteredData.length > 0 && (
        <div className="pagination-container">
          <div className="showing-info">
            Showing rows {startIndex + 1}-{Math.min(endIndex, filteredData.length)} of {filteredData.length}
          </div>
          
          {totalPages > 1 && (
            <div className="pagination-controls">
              <button 
                className="page-btn"
                onClick={() => setCurrentPage(1)}
                disabled={currentPage === 1}
              >
                First
              </button>
              <button 
                className="page-btn"
                onClick={() => setCurrentPage(currentPage - 1)}
                disabled={currentPage === 1}
              >
                Previous
              </button>
              
              {getPageNumbers().map((page, index) => (
                page === '...' ? (
                  <span key={`ellipsis-${index}`} className="page-ellipsis">...</span>
                ) : (
                  <button
                    key={`page-${page}`}
                    className={`page-btn page-number ${currentPage === page ? 'active' : ''}`}
                    onClick={() => setCurrentPage(page)}
                  >
                    {page}
                  </button>
                )
              ))}
              
              <button 
                className="page-btn"
                onClick={() => setCurrentPage(currentPage + 1)}
                disabled={currentPage === totalPages}
              >
                Next
              </button>
              <button 
                className="page-btn"
                onClick={() => setCurrentPage(totalPages)}
                disabled={currentPage === totalPages}
              >
                Last
              </button>
            </div>
          )}
        </div>
      )}
      
      <style jsx>{`
        .transaction-codes-container {
          padding: 20px;
        }
        
        table {
          width: 100%;
          border-collapse: collapse;
          table-layout: fixed;
        }
        
        th, td {
          padding: 10px 12px;
          text-align: left;
          vertical-align: middle;
          border: 1px solid #dee2e6;
        }
        
        th {
          background-color: rgb(23, 41, 176);
          color: white;
          font-weight: 600;
          font-size: 14px;
          text-transform: uppercase;
          letter-spacing: 0.5px;
        }
        
        td {
          font-size: 14px;
        }
        
        .filter-row td {
          background-color: #f8f9fa;
          padding: 6px;
          border: 1px solid #dee2e6;
        }
        
        .filter-input {
          width: 100%;
          padding: 6px 10px;
          border: 1px solid #ced4da;
          border-radius: 3px;
          font-size: 14px;
          background-color: white;
          box-sizing: border-box;
          height: 32px;
        }
        
        .filter-input:focus {
          outline: none;
          border-color: rgb(23, 41, 176);
          box-shadow: 0 0 0 2px rgba(76, 175, 80, 0.1);
        }
        
        .filter-input::placeholder {
          color: #999;
          opacity: 1;
          font-size: 13px;
        }
        
        tbody tr:hover {
          background-color: #f5f5f5;
        }
        
        .pagination-container {
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin-top: 20px;
          padding: 15px;
          background-color: #f8f9fa;
        }
        
        .showing-info {
          font-size: 14px;
          color: #666;
        }
        
        .pagination-controls {
          display: flex;
          gap: 5px;
          align-items: center;
        }
        
        .page-btn {
          padding: 6px 12px;
          border: 1px solid #dee2e6;
          background-color: white;
          color: #333;
          font-size: 14px;
          cursor: pointer;
          border-radius: 3px;
        }
        
        .page-btn:hover:not(:disabled) {
          background-color: #5a9ca6;
          color: white;
          border-color: #5a9ca6;
        }
        
        .page-btn:disabled {
          opacity: 0.5;
          cursor: not-allowed;
        }
        
        .page-btn.page-number {
          min-width: 35px;
        }
        
        .page-btn.active {
          background-color: rgb(23, 41, 176);
          color: white;
          border-color: rgb(23, 41, 176);
        }
        
        .page-ellipsis {
          padding: 0 8px;
          color: #666;
        }
      `}</style>
    </div>
  );
};

export default TransactionCodes;
