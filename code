from pathlib import Path

# Reconstruct the full updated TabbedTables.jsx with the new 'detailedDescription' field added
updated_code = """\
import React, { useState } from 'react';
import {
  DataTable, DataTableHead, DataTableBody, DataTableRow,
  DataTableCell, DataTableHeadCell, Button,
} from '@americanexpress/dls-react';
import { IconDownload, IconFilter } from '@americanexpress/dls-icons';

import triumphTransData from '../data/Triumph_Trans_Codes.json';
import triumphStatusData from '../data/Triumph_Status_Codes.json';
import FilterMenu from './FilterMenu';

const inputStyle = {
  padding: '6px',
  width: '100%',
  border: '1px solid #ccc',
  borderRadius: '4px',
  boxSizing: 'border-box',
};

const iconStyle = {
  padding: '6px',
  cursor: 'pointer',
};

const suggestionBoxStyle = {
  position: 'absolute',
  top: '38px',
  width: '100%',
  background: '#fff',
  border: '1px solid #ccc',
  borderRadius: '4px',
  boxShadow: '2px 6px rgba(0,0,0,0.1)',
  zIndex: 15,
};

const suggestionItemStyle = {
  padding: '6px',
  cursor: 'pointer',
  borderBottom: '1px solid #eee',
};

const TabbedTables = () => {
  const [activeTab, setActiveTab] = useState(null);
  const [filters, setFilters] = useState(['name', 'value', 'description', 'detailedDescription', 'source']);
  const [showFilterMenu, setShowFilterMenu] = useState(false);
  const [showDownloadMenu, setShowDownloadMenu] = useState(false);
  const [inputFilters, setInputFilters] = useState({
    name: '', value: '', description: '', detailedDescription: '', source: '',
  });
  const [suggestions, setSuggestions] = useState({
    name: [], value: [], description: [], detailedDescription: [], source: [],
  });

  const transData = triumphTransData.Triumph_Trans_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    detailedDescription: '', // Placeholder
    source: item['System Source Name'],
  }));

  const acctData = triumphStatusData.Triumph_Status_Codes.map((item) => ({
    name: item['Field Name'],
    value: item['Field Value'],
    description: item['Field Description'],
    detailedDescription: '', // Placeholder
    source: item['System Source Name'],
  }));

  const allData = activeTab === 'trans' ? transData : acctData;

  const getFilteredRows = () => {
    const currentInput = inputFilters[activeTab];
    return allData.filter((row) =>
      (!currentInput.name || row.name?.toLowerCase().includes(currentInput.name.toLowerCase())) &&
      (!currentInput.value || row.value?.toLowerCase().includes(currentInput.value.toLowerCase())) &&
      (!currentInput.description || row.description?.toLowerCase().includes(currentInput.description.toLowerCase())) &&
      (!currentInput.detailedDescription || row.detailedDescription?.toLowerCase().includes(currentInput.detailedDescription.toLowerCase())) &&
      (!currentInput.source || row.source?.toLowerCase().includes(currentInput.source.toLowerCase()))
    );
  };

  const handleToggle = (tab) => {
    setActiveTab(tab);
    setShowDownloadMenu(false);
    setShowFilterMenu(false);
    setInputFilters((prev) => ({
      ...prev,
      [tab]: { name: '', value: '', description: '', detailedDescription: '', source: '' },
    }));
    setSuggestions({
      name: [], value: [], description: [], detailedDescription: [], source: [],
    });
  };

  const handleInputChange = (field, value) => {
    setInputFilters((prev) => ({
      ...prev,
      [activeTab]: {
        ...prev[activeTab],
        [field]: value,
      },
    }));
    const matches = [...new Set(
      allData
        .map((item) => item[field])
        .filter((val) => val?.toLowerCase().includes(value.toLowerCase()))
        .slice(0, 5)
    )];
    setSuggestions((prev) => ({
      ...prev,
      [field]: value ? matches : [],
    }));
  };

  const handleSuggestionClick = (field, value) => {
    handleInputChange(field, value);
    setSuggestions((prev) => ({
      ...prev,
      [field]: [],
    }));
  };

  const renderInputWithSuggestions = (field, placeholder) => (
    <div style={{ position: 'relative', width: '100%' }}>
      <input
        type="text"
        placeholder={placeholder}
        value={inputFilters[activeTab][field]}
        onChange={(e) => handleInputChange(field, e.target.value)}
        style={inputStyle}
      />
      {suggestions[field].length > 0 && (
        <div style={suggestionBoxStyle}>
          {suggestions[field].map((item) => (
            <button
              key={item}
              type="button"
              style={suggestionItemStyle}
              onClick={() => handleSuggestionClick(field, item)}
            >
              {item}
            </button>
          ))}
        </div>
      )}
    </div>
  );

  const downloadData = (format) => {
    const data = getFilteredRows();
    let blob;
    let filename;

    if (format === 'json') {
      blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      filename = activeTab === 'trans' ? 'Transaction_Codes.json' : 'Account_Status_Codes.json';
    } else {
      const header = filters.join(',');
      const csvRows = data.map((row) => filters.map((f) => `"${row[f] || ''}"`).join(','));
      const csvContent = [header, ...csvRows].join('\\n');
      blob = new Blob([csvContent], { type: 'text/csv' });
      filename = activeTab === 'trans' ? 'Transaction_Codes.csv' : 'Account_Status_Codes.csv';
    }

    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
    setShowDownloadMenu(false);
  };

  const renderTable = (rows) => (
    <div style={{ maxHeight: '50vh', overflow: 'auto', padding: '10px', boxSizing: 'border-box' }}>
      <DataTable borders="all" density="default" tableLayout="auto">
        <DataTableHead>
          <DataTableRow>
            {filters.includes('name') && <DataTableHeadCell>{renderInputWithSuggestions('name', 'Filter Field Name...')}</DataTableHeadCell>}
            {filters.includes('value') && <DataTableHeadCell>{renderInputWithSuggestions('value', 'Filter Field Value...')}</DataTableHeadCell>}
            {filters.includes('description') && <DataTableHeadCell>{renderInputWithSuggestions('description', 'Filter Field Description...')}</DataTableHeadCell>}
            {filters.includes('detailedDescription') && <DataTableHeadCell>{renderInputWithSuggestions('detailedDescription', 'Filter Detailed Description...')}</DataTableHeadCell>}
            {filters.includes('source') && <DataTableHeadCell>{renderInputWithSuggestions('source', 'Filter System Source Name...')}</DataTableHeadCell>}
          </DataTableRow>
        </DataTableHead>
        <DataTableBody>
          {rows.map((row, idx) => (
            <DataTableRow key={idx}>
              {filters.includes('name') && <DataTableCell>{row.name}</DataTableCell>}
              {filters.includes('value') && <DataTableCell>{row.value}</DataTableCell>}
              {filters.includes('description') && <DataTableCell>{row.description}</DataTableCell>}
              {filters.includes('detailedDescription') && <DataTableCell>{row.detailedDescription}</DataTableCell>}
              {filters.includes('source') && <DataTableCell>{row.source}</DataTableCell>}
            </DataTableRow>
          ))}
        </DataTableBody>
      </DataTable>
    </div>
  );

  return (
    <div>
      <div style={{ display: 'flex', justifyContent: 'center', gap: '30px', marginTop: '40px' }}>
        <Button variant={activeTab === 'trans' ? 'secondary' : 'primary'} onClick={() => handleToggle('trans')}>Transaction Codes</Button>
        <Button variant={activeTab === 'acct' ? 'secondary' : 'primary'} onClick={() => handleToggle('acct')}>Account Status Codes</Button>
      </div>
      {activeTab && (
        <div style={{ display: 'flex', gap: '12px', justifyContent: 'flex-start', position: 'relative', paddingLeft: '10%' }}>
          <IconDownload title="Download" onClick={() => setShowDownloadMenu((prev) => !prev)} style={iconStyle} />
          <IconFilter title="Filter" onClick={() => setShowFilterMenu((prev) => !prev)} style={iconStyle} />
        </div>
      )}
      {renderTable(getFilteredRows())}
    </div>
  );
};

export default TabbedTables;
"""

# Save the code to a file and return the path
file_path = "/mnt/data/TabbedTables.jsx"
Path(file_path).write_text(updated_code)

